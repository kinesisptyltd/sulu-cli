#!/bin/sh -eu

# Bootstrap the project for development from a fresh clone.
# Idempotent: safe to run multiple times.

cd "$(git rev-parse --show-toplevel)"

if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo not found. Install Rust via https://rustup.rs/" >&2
    exit 1
fi

# Install GDAL system library (required for the formats-gdal feature).
if ! command -v gdal-config >/dev/null 2>&1; then
    if [ "$(uname -s)" = "Darwin" ]; then
        if command -v brew >/dev/null 2>&1; then
            brew list gdal >/dev/null 2>&1 || brew install gdal
        else
            echo "error: Homebrew not found; install gdal manually." >&2
            exit 1
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        if [ "$(id -u)" -eq 0 ]; then
            apt-get update
            apt-get install -y libgdal-dev
        else
            sudo apt-get update
            sudo apt-get install -y libgdal-dev
        fi
    else
        echo "error: unknown platform; install gdal manually." >&2
        exit 1
    fi
fi

# gdal-config must be present now; fail loudly otherwise.
if ! command -v gdal-config >/dev/null 2>&1; then
    echo "error: gdal-config still not found after install attempt." >&2
    exit 1
fi

# gdal-sys ships pre-built FFI bindings for a fixed set of GDAL minor versions
# (currently GDAL 3.4 through 3.12). Its build script auto-detects the system
# GDAL via pkg-config and selects the matching bindings. GDAL keeps a stable C
# ABI across the 3.x series, so if the system GDAL falls outside the range with
# pre-built bindings we point gdal-sys at the nearest applicable ones via the
# GDAL_VERSION override its build script honors. We persist the pin in
# .cargo/config.toml so the plain `cargo build` / `cargo test` used downstream
# pick it up too (an env var exported here would not survive into those
# separate invocations).
gdal_version="$(gdal-config --version)"
gdal_major="${gdal_version%%.*}"
gdal_rest="${gdal_version#*.}"
gdal_minor="${gdal_rest%%.*}"

# Oldest and newest GDAL minor versions gdal-sys ships pre-built 3.x bindings for.
prebuilt_min_minor=4
prebuilt_max_minor=12

pinned_version=""
case "$gdal_major" in
    3)
        if [ "$gdal_minor" -lt "$prebuilt_min_minor" ]; then
            pinned_version="3.$prebuilt_min_minor.0"
        elif [ "$gdal_minor" -gt "$prebuilt_max_minor" ]; then
            pinned_version="3.$prebuilt_max_minor.0"
        else
            pinned_version="$gdal_version"
        fi
        ;;
    [4-9]*) pinned_version="3.$prebuilt_max_minor.0" ;;  # GDAL 4+: best effort with newest 3.x bindings
esac

if [ -n "$pinned_version" ]; then
    echo "system GDAL is $gdal_version; pinning gdal-sys bindings to $pinned_version"
    mkdir -p .cargo
    cat > .cargo/config.toml <<EOF
# Generated by bin/setup. gdal-sys ships pre-built bindings for a set of GDAL
# minor versions; pin GDAL_VERSION to the system GDAL ($gdal_version) so its
# build script selects the matching pre-built bindings.
[env]
GDAL_VERSION = "$pinned_version"
EOF
else
    echo "system GDAL is $gdal_version; gdal-sys has matching pre-built bindings"
fi

# Pre-fetch cargo dependencies.
cargo fetch --locked

# Build the workspace with all feature combinations exercised in CI so
# subsequent test runs are fast.
(cd sulu-lib && cargo build --no-default-features)
(cd sulu-lib && cargo build --features "formats-geojson")
(cd sulu-lib && cargo build --features "formats-gdal")
cargo build

echo "setup complete"
