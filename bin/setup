#!/bin/sh -eu

# Bootstrap the project for development from a fresh clone.
# Idempotent: safe to run multiple times.

cd "$(git rev-parse --show-toplevel)"

if ! command -v cargo >/dev/null 2>&1; then
    echo "error: cargo not found. Install Rust via https://rustup.rs/" >&2
    exit 1
fi

# Install GDAL system library (required for the formats-gdal feature).
if ! command -v gdal-config >/dev/null 2>&1; then
    if [ "$(uname -s)" = "Darwin" ]; then
        if command -v brew >/dev/null 2>&1; then
            brew list gdal >/dev/null 2>&1 || brew install gdal
        else
            echo "error: Homebrew not found; install gdal manually." >&2
            exit 1
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        if [ "$(id -u)" -eq 0 ]; then
            apt-get update
            apt-get install -y libgdal-dev
        else
            sudo apt-get update
            sudo apt-get install -y libgdal-dev
        fi
    else
        echo "error: unknown platform; install gdal manually." >&2
        exit 1
    fi
fi

# gdal-config must be present now; fail loudly otherwise.
if ! command -v gdal-config >/dev/null 2>&1; then
    echo "error: gdal-config still not found after install attempt." >&2
    exit 1
fi

# gdal-sys (pinned at 0.3.1 via Cargo.lock) ships pre-built FFI bindings
# only up to GDAL 3.2. A newer system GDAL -- e.g. the 3.8 that current
# Debian/Ubuntu ship -- makes its build script panic with
#   "No pre-built bindings available for GDAL version 3.8."
# GDAL keeps a stable C ABI across the 3.x series, so we point gdal-sys at
# its newest applicable pre-built bindings via the GDAL_VERSION override its
# build script already honors. We persist this in .cargo/config.toml so the
# plain `cargo build` / `cargo test` used downstream pick it up too (an env
# var exported here would not survive into those separate invocations).
gdal_version="$(gdal-config --version)"
gdal_major="${gdal_version%%.*}"
gdal_rest="${gdal_version#*.}"
gdal_minor="${gdal_rest%%.*}"

pinned_version=""
case "$gdal_major" in
    2) [ "$gdal_minor" -gt 4 ] && pinned_version="2.4.0" ;;
    3) [ "$gdal_minor" -gt 2 ] && pinned_version="3.2.0" ;;
    [4-9]*) pinned_version="3.2.0" ;;  # GDAL 4+: best effort with newest 3.x bindings
esac

if [ -n "$pinned_version" ]; then
    echo "system GDAL is $gdal_version; pinning gdal-sys bindings to $pinned_version"
    mkdir -p .cargo
    cat > .cargo/config.toml <<EOF
# Generated by bin/setup. gdal-sys 0.3.1 has no pre-built bindings for the
# system GDAL ($gdal_version); pin it to the newest compatible bindings.
[env]
GDAL_VERSION = "$pinned_version"
EOF
else
    echo "system GDAL is $gdal_version; gdal-sys has matching pre-built bindings"
fi

# Pre-fetch cargo dependencies.
cargo fetch --locked

# Build the workspace with all feature combinations exercised in CI so
# subsequent test runs are fast.
(cd sulu-lib && cargo build --no-default-features)
(cd sulu-lib && cargo build --features "formats-geojson")
(cd sulu-lib && cargo build --features "formats-gdal")
cargo build

echo "setup complete"
